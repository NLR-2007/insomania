# ── build output ──────────────────────────────────────────────────────────
app/bin/
app/obj/
build/
dist/
web/dist/
*.pdb
*.rsp

# ── release binaries ──────────────────────────────────────────────────────
# Insominia.exe is ~139 MB self-contained, well over GitHub's 100 MB file
# limit, and a binary does not belong in source history anyway. Ship it as a
# GitHub Release asset instead.
release/
*.exe

# ── web ───────────────────────────────────────────────────────────────────
node_modules/
*.local

