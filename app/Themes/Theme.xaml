<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Palette - a dark, quiet surface so the accent carries meaning
         ============================================================ -->

    <!-- Monochrome. Neutral greys carry the whole interface and colour appears
         ONLY where it means something: a green dot for working, amber for
         caution, red for stop. With no signature colour pair there is nothing
         to look dated or generic - the hierarchy comes from contrast and
         spacing instead of from hue. -->

    <Color x:Key="BgDeepColor">#0A0A0B</Color>
    <Color x:Key="BgColor">#0F0F10</Color>
    <Color x:Key="SurfaceColor">#161618</Color>
    <Color x:Key="SurfaceHoverColor">#1E1E21</Color>
    <Color x:Key="BorderColor">#2A2A2E</Color>
    <Color x:Key="BorderSoftColor">#1E1E21</Color>

    <Color x:Key="TextColor">#FAFAFA</Color>
    <Color x:Key="TextMutedColor">#8B8B90</Color>
    <Color x:Key="TextFaintColor">#5B5B61</Color>

    <!-- The accent is sampled straight from the logo (#20E8D2), so the app and
         its icon are the same object. It is the ONLY decorative colour; greys
         do everything else. -->
    <Color x:Key="AccentColor">#20E8D2</Color>
    <Color x:Key="AccentDimColor">#15B5A4</Color>

    <!-- Working is the brand colour: on means lit. Amber and red are reserved
         strictly for "needs attention" and "stopping". -->
    <Color x:Key="LiveColor">#20E8D2</Color>
    <Color x:Key="WarnColor">#FFB224</Color>
    <Color x:Key="DangerColor">#FF453A</Color>

    <SolidColorBrush x:Key="BgDeep" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoft" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource TextFaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="Live" Color="{StaticResource LiveColor}" />
    <SolidColorBrush x:Key="Warn" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />

    <!-- Depth comes from layering, not from borders alone: the window sits
         darkest, the sidebar lifts slightly, cards lift again with a faint
         top highlight so they catch the light like real surfaces. -->

    <SolidColorBrush x:Key="SidebarBg" Color="#0C0C0D" />

    <LinearGradientBrush x:Key="CardSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18181B" Offset="0" />
        <GradientStop Color="#141416" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardSurfaceHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#202024" Offset="0" />
        <GradientStop Color="#1A1A1D" Offset="1" />
    </LinearGradientBrush>

    <!-- Working: the card simply lifts a step brighter. No tint - in a
         monochrome scheme, elevation is the signal. -->
    <LinearGradientBrush x:Key="CardSurfaceLive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#232327" Offset="0" />
        <GradientStop Color="#1B1B1F" Offset="1" />
    </LinearGradientBrush>

    <!-- A one-pixel highlight along the top edge reads as a lit surface -->
    <LinearGradientBrush x:Key="TopHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Primary buttons carry the brand cyan with a near-black label -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2BF0DC" Offset="0" />
        <GradientStop Color="#16C9B6" Offset="1" />
    </LinearGradientBrush>

    <!-- Meters stay neutral; only the small status dot is actually green -->
    <LinearGradientBrush x:Key="LiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FAFAFA" Offset="0" />
        <GradientStop Color="#A1A1A8" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================
         Motion - one shared feel. Short, eased, never linear.
         ============================================================ -->

    <Duration x:Key="FastDuration">0:0:0.14</Duration>
    <Duration x:Key="BaseDuration">0:0:0.22</Duration>
    <Duration x:Key="SlowDuration">0:0:0.34</Duration>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
    <BackEase x:Key="EaseBack" EasingMode="EaseOut" Amplitude="0.4" />

    <!-- ============================================================
         Type
         ============================================================ -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Micro" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ============================================================
         Buttons
         ============================================================ -->

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#0A0A0B" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{StaticResource AccentGradient}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="sc" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small pill used for the auto-stop choices -->
    <Style x:Key="ChipToggle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="9" Padding="12,6" Margin="0,0,6,0"
                            Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#122826" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Cards and rows
         ============================================================ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Section label above a group of rows -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!-- ============================================================
         Scrollbar - thin and unobtrusive
         ============================================================ -->

    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3A46" CornerRadius="4" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Search / text input -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
