<Window x:Class="Insominia.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Insominia.Controls"
        Title="Insominia"
        Width="940" Height="650" MinWidth="820" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Icon="/Assets/logo.png"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A row in the app list. Hover lifts it, a kept app gets a green edge. -->
            <Style x:Key="AppRow" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,0,0,7" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardSurfaceHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="bd" CornerRadius="9" Padding="12,9" Background="Transparent" />
                                <!-- the little accent bar that marks the current page -->
                                <Border x:Name="mark" Width="3" Height="16" CornerRadius="2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource Accent}" Opacity="0" />
                                <ContentPresenter Margin="12,9" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#161618" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#202024" />
                                    <Setter TargetName="mark" Property="Opacity" Value="1" />
                                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="7" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ════════════ SIDEBAR ════════════ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBg}" CornerRadius="16,0,0,16">
                <Grid Margin="14,14,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- brand -->
                    <StackPanel Grid.Row="0" Margin="4,2,4,16">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/logo.png" Width="24" Height="24" Margin="0,0,10,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="Insominia" Style="{StaticResource Body}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Micro}" Margin="0,9,0,0"
                                   TextWrapping="Wrap" LineHeight="15"
                                   Text="Give your laptop Insominia and get your freedom back." />
                    </StackPanel>

                    <!-- live status: the master switch lives here, always reachable -->
                    <Border Grid.Row="1" x:Name="StatusCard" Style="{StaticResource Card}"
                            Padding="14,13" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SideState" Text="Ready" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="SideSub" Text="lid close sleeps"
                                               Style="{StaticResource Micro}" Margin="0,3,0,0" />
                                </StackPanel>
                                <ctl:ToggleSwitch x:Name="SwMaster" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <TextBlock x:Name="SideBatteryLabel" Text="BATTERY" Style="{StaticResource Micro}" />
                                <TextBlock x:Name="SideBatteryValue" Text="--" Style="{StaticResource Micro}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" />
                            </Grid>
                            <Border Height="4" CornerRadius="2" Background="#26262F">
                                <Border x:Name="SideBatteryFill" Height="4" CornerRadius="2" Width="0"
                                        HorizontalAlignment="Left" Background="{StaticResource LiveGradient}" />
                            </Border>

                            <Grid x:Name="TimerRow" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TimerLabel" Text="RUNNING" Style="{StaticResource Micro}" />
                                <TextBlock x:Name="TimerValue" Text="--" Style="{StaticResource Micro}"
                                           HorizontalAlignment="Right" Foreground="{StaticResource Live}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- nav -->
                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="NavApps" Style="{StaticResource NavItem}" IsChecked="True">
                            <Grid>
                                <TextBlock Text="Apps" />
                                <TextBlock x:Name="NavAppsBadge" HorizontalAlignment="Right"
                                           Style="{StaticResource Micro}" Margin="0,1,0,0" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Content="Settings" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Content="Diagnostics" />
                    </StackPanel>

                    <!-- setup nudge sits in the gap, so the column is never empty -->
                    <Border Grid.Row="3" x:Name="SideSetup" VerticalAlignment="Bottom"
                            CornerRadius="12" Padding="13,12" Margin="0,14,0,12"
                            Background="#1A1611" BorderThickness="1" BorderBrush="#3A2F1C"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="One step left" Style="{StaticResource Micro}"
                                       Foreground="{StaticResource Warn}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,9" FontSize="11"
                                       Text="Windows needs permission once before the lid can stay closed." />
                            <Button x:Name="BtnSideSetup" Style="{StaticResource PrimaryButton}"
                                    Content="Finish setup" Padding="12,7" FontSize="12"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- footer -->
                    <StackPanel Grid.Row="4">
                        <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="2,0,2,10" />
                        <Grid Margin="4,0,4,0">
                            <TextBlock x:Name="SideFooter" Style="{StaticResource Micro}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="v2.0" Style="{StaticResource Micro}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ════════════ CONTENT ════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- title bar -->
                <Grid x:Name="TitleBar" Grid.Row="0" Height="46" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button x:Name="BtnMinimise" Style="{StaticResource GhostButton}" Content="&#xE921;"
                                FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="12,8" />
                        <Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Content="&#xE8BB;"
                                FontFamily="Segoe MDL2 Assets" FontSize="10" Padding="12,8" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="22,0,22,20">

                    <!-- ===== APPS ===== -->
                    <Grid x:Name="PageApps">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Which apps must keep running?" Style="{StaticResource H1}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,5,40,0"
                                       Text="Apps you leave off are slowed down while the lid is shut. Nothing closes, nothing is lost - they speed straight back up when you switch off." />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <TextBox x:Name="Search" Style="{StaticResource SearchBox}" Padding="36,9,12,9" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                                       Margin="13,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Search apps" IsHitTestVisible="False"
                                       Style="{StaticResource Caption}" Margin="36,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer Grid.Row="2" Margin="0,0,-10,0" Padding="0,0,10,0">
                            <StackPanel>
                                <TextBlock x:Name="LabelKept" Style="{StaticResource SectionLabel}"
                                           Text="KEPT AT FULL SPEED" />
                                <ItemsControl x:Name="ListKept" Margin="0,0,0,6" />

                                <TextBlock x:Name="LabelSlowed" Style="{StaticResource SectionLabel}"
                                           Text="WILL BE SLOWED DOWN" Margin="2,10,0,8" />
                                <ItemsControl x:Name="ListSlowed" />

                                <TextBlock x:Name="EmptyNote" Style="{StaticResource Caption}"
                                           Margin="2,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <TextBlock x:Name="AppsSummary" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnRefresh" Style="{StaticResource GhostButton}" Content="Refresh" />
                                <Button x:Name="BtnClearAll" Style="{StaticResource GhostButton}" Content="Clear all" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== SETTINGS ===== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" Margin="0,0,-10,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Settings" Style="{StaticResource H1}" Margin="0,0,0,16" />

                            <TextBlock Text="AUTO-STOP AFTER" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,11"
                                               Text="Insominia switches itself off after this long, so a forgotten session cannot drain the battery." />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ChipNever" Style="{StaticResource ChipToggle}" Content="Never" Tag="0" />
                                        <RadioButton x:Name="Chip30" Style="{StaticResource ChipToggle}" Content="30 min" Tag="30" />
                                        <RadioButton x:Name="Chip60" Style="{StaticResource ChipToggle}" Content="1 hour" Tag="60" />
                                        <RadioButton x:Name="Chip120" Style="{StaticResource ChipToggle}" Content="2 hours" Tag="120" />
                                        <RadioButton x:Name="Chip240" Style="{StaticResource ChipToggle}" Content="4 hours" Tag="240" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid>
                                    <StackPanel Margin="0,0,62,0">
                                        <TextBlock Text="Battery saver" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                   Text="Slow down apps you have not picked, using the same mechanism Windows uses for background browser tabs." />
                                    </StackPanel>
                                    <ctl:ToggleSwitch x:Name="SwSaver" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <Grid>
                                    <StackPanel Margin="0,0,62,0">
                                        <TextBlock Text="Start with Windows" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                   Text="Insominia sits quietly in the tray until you need it." />
                                    </StackPanel>
                                    <ctl:ToggleSwitch x:Name="SwStartup" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <TextBlock Text="PERMISSION" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="One-time setup" Style="{StaticResource Body}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SetupState" Style="{StaticResource Caption}" Margin="0,4,0,11" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnDoSetup" Style="{StaticResource PrimaryButton}"
                                                Content="Run setup" Margin="0,0,8,0" />
                                        <Button x:Name="BtnUndoSetup" Style="{StaticResource GhostButton}" Content="Remove" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="SAFETY" Style="{StaticResource SectionLabel}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="SafetyText" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== DIAGNOSTICS ===== -->
                    <Grid x:Name="PageAbout" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Diagnostics" Style="{StaticResource H1}" Margin="0,0,0,16" />

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                <TextBlock x:Name="DiagText" FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="NoWrap" LineHeight="19" />
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button x:Name="BtnOpenLogs" Style="{StaticResource GhostButton}" Content="Open log folder" />
                            <Button x:Name="BtnRefreshDiag" Style="{StaticResource GhostButton}" Content="Refresh" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
