<Window x:Class="Insominia.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:Insominia.Controls"
        Title="Insominia"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer margin leaves room for the shadow to breathe -->
    <Grid Margin="16">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="PanelScale" CenterX="170" CenterY="300" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="PanelShift" Y="0" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border CornerRadius="18" Background="{StaticResource BgDeep}"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270"
                                  Opacity="0.55" Color="Black" />
            </Border.Effect>

            <StackPanel Margin="18,16,18,14">

                <!-- ░░ header ░░ -->
                <Grid Margin="0,0,0,14">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/logo.png" Width="20" Height="20" Margin="0,0,9,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                            <TextBlock Text="Insominia" Style="{StaticResource H2}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource TextFaint}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Micro}" Margin="29,6,80,0"
                                   TextWrapping="Wrap" LineHeight="15"
                                   Text="Give your laptop Insominia and get your freedom back." />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button x:Name="BtnOpenMain" Style="{StaticResource GhostButton}"
                                Content="Apps &amp; settings" ToolTip="Open the full window" />
                    </StackPanel>
                </Grid>

                <!-- ░░ the one switch that matters ░░ -->
                <Border Style="{StaticResource Card}" Padding="16,15" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="Headline" Text="Ready" Style="{StaticResource H1}" />
                            <TextBlock x:Name="Detail" Text="Turn on before you walk away"
                                       Style="{StaticResource Caption}" Margin="0,3,70,0" />
                        </StackPanel>

                        <ctl:ToggleSwitch x:Name="MainSwitch"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ░░ live readout ░░ -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BATTERY" Style="{StaticResource Micro}" />
                            <TextBlock x:Name="BatteryValue" Text="--" Style="{StaticResource Body}"
                                       FontWeight="SemiBold" Margin="0,4,0,4" />
                            <Border Height="4" CornerRadius="2" Background="#26262F">
                                <Border x:Name="BatteryFill" Height="4" CornerRadius="2"
                                        HorizontalAlignment="Left" Width="0"
                                        Background="{StaticResource LiveGradient}" />
                            </Border>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Margin="14,2" Fill="{StaticResource BorderSoft}" />

                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="RightLabel" Text="RUNNING FOR" Style="{StaticResource Micro}" />
                            <TextBlock x:Name="RightValue" Text="--" Style="{StaticResource Body}"
                                       FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock x:Name="RightHint" Text="" Style="{StaticResource Micro}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ░░ auto-stop ░░ -->
                <TextBlock Text="AUTO-STOP AFTER" Style="{StaticResource Micro}" Margin="2,4,0,7" />
                <StackPanel x:Name="ChipRow" Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="ChipNever" Style="{StaticResource ChipToggle}" Content="Never" Tag="0" />
                    <RadioButton x:Name="Chip30"    Style="{StaticResource ChipToggle}" Content="30m"   Tag="30" />
                    <RadioButton x:Name="Chip60"    Style="{StaticResource ChipToggle}" Content="1h"    Tag="60" />
                    <RadioButton x:Name="Chip120"   Style="{StaticResource ChipToggle}" Content="2h"    Tag="120" />
                    <RadioButton x:Name="Chip240"   Style="{StaticResource ChipToggle}" Content="4h"    Tag="240" />
                </StackPanel>

                <!-- ░░ battery saver ░░ -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,62,0">
                            <TextBlock Text="Battery saver" Style="{StaticResource Body}" FontWeight="SemiBold" />
                            <TextBlock x:Name="SaverDetail" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="Slow down apps you have not picked" />
                        </StackPanel>
                        <ctl:ToggleSwitch x:Name="SaverSwitch"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ░░ setup warning, only when it matters ░░ -->
                <Border x:Name="SetupBanner" Visibility="Collapsed" Margin="0,0,0,10"
                        CornerRadius="12" Padding="13,11" Background="#1A1611" BorderThickness="1"
                        BorderBrush="#3A2F1C">
                    <StackPanel>
                        <TextBlock Text="One step left" Style="{StaticResource Body}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,9"
                                   Text="Windows needs permission once before the lid can stay closed." />
                        <Button x:Name="BtnSetup" Style="{StaticResource PrimaryButton}"
                                Content="Finish setup" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- ░░ footer ░░ -->
                <Grid Margin="0,2,0,0">
                    <TextBlock x:Name="FooterHint" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnQuit" Style="{StaticResource GhostButton}" Content="Quit" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
